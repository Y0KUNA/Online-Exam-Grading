# Shared security
JWT_ISSUER=https://identity.local
JWT_JWKS_URI=http://identity:8081/.well-known/jwks.json
JWT_ROLE_CLAIM=role
IDENTITY_HMAC_SECRET=replace-with-a-32-byte-minimum-secret
JWT_SIGNING_KEY=replace-with-an-rsa-private-key
AUTH_LOCAL_ENABLED=true
JWT_TTL_MINUTES=15

# Bootstrap account (development only)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Data stores
POSTGRES_USER=exam_grading
POSTGRES_PASSWORD=change-me
RABBITMQ_DEFAULT_USER=exam_grading
RABBITMQ_DEFAULT_PASS=change-me
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_BASE=http://localhost:8080/storage

# Processing defaults
UPLOAD_TTL_MINUTES=10
DOWNLOAD_TTL_MINUTES=5
MAX_PDF_BYTES=52428800
MAX_DOCX_BYTES=20971520
ANON_RENDER_DPI=200
REMARK_ALLOW_AFTER_FINALIZED=true
REMARK_WINDOW_DAYS=0
