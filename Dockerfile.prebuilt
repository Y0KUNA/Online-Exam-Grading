# Temporary Dockerfile for local E2E runs: uses bootJar built on the host
# (docker build of ./gradlew inside the container timed out downloading the
# Gradle distribution). Not for CI.
FROM eclipse-temurin:21-jre
ARG SERVICE
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY ${SERVICE}/build/libs/*.jar app.jar
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
